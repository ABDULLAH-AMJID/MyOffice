<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qr_background">

    <androidx.camera.view.PreviewView
        android:id="@+id/qrPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.myoffice.app.qr.ScanFrameOverlay
        android:id="@+id/qrOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/qrTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/qrClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_qr_circle"
            android:contentDescription="@string/qr_close"
            android:padding="11dp"
            android:src="@drawable/ic_qr_close" />

        <TextView
            android:id="@+id/qrTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/qr_title"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/qrTorch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_qr_circle"
            android:contentDescription="@string/qr_torch"
            android:padding="11dp"
            android:src="@drawable/ic_qr_torch_off" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/qrBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="8dp"
        android:paddingEnd="28dp"
        android:paddingBottom="30dp">

        <TextView
            android:id="@+id/qrHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/qr_hint"
            android:textColor="#E6EAFF"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/qrGallery"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_qr_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="20dp">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@string/qr_gallery"
                android:src="@drawable/ic_qr_gallery" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:text="@string/qr_gallery"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
